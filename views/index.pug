html
  head
    title My Express App
    link(rel="stylesheet", href="/styles.css")
  body
    h1 Welcome to My Express App
    p= message

    h2 Users
    table
      thead
        tr
          th ID
          th Name
          th Email
      tbody
        each user in users
          tr
            td= user.id
            td= user.name
            td= user.email

    h2 Genres
    table
      thead
        tr
          th ID
          th Name
      tbody
        each genre in genres
          tr
            td= genre.id
            td= genre.name